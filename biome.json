{
  "files": {
    "includes": [
      "**",
      "!__test__/data",
      "!package.json",
      "!!**/dist",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noUselessElse": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  }
}
